{
  "name": "cortex-54",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "CORTEX-54: free-tier autonomous trading harness on Cloudflare Workers with Discord C2",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "config:build": "node scripts/build-config.ts",
    "typecheck": "pnpm config:build && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p web/tsconfig.json",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "pnpm config:build && vitest run",
    "test:watch": "vitest",
    "dev": "pnpm config:build && wrangler dev",
    "deploy:cortex": "pnpm config:build && pnpm web:build && wrangler deploy",
    "sentinel:dev": "wrangler dev -c workers/sentinel/wrangler.jsonc",
    "deploy:sentinel": "wrangler deploy -c workers/sentinel/wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply cortex-journal --local",
    "db:migrate:remote": "wrangler d1 migrations apply cortex-journal --remote",
    "discord:register": "node scripts/register-commands.ts",
    "discord:setup": "node scripts/discord-setup.ts",
    "court:smoke": "tsx scripts/court-smoke.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "cortex": "tsx local/cli.ts",
    "local": "pnpm config:build && tsx local/cli.ts start",
    "demo": "pnpm config:build && pnpm web:build && tsx local/cli.ts demo",
    "cortexd:build": "pnpm config:build && pnpm web:build && tsx scripts/build-cortexd.ts",
    "desktop:runtime": "tsx scripts/fetch-node-runtime.ts",
    "desktop:build": "pnpm cortexd:build && tauri build --config desktop/src-tauri/tauri.conf.json",
    "desktop:dev": "pnpm cortexd:build && tauri build --debug --bundles app --config desktop/src-tauri/tauri.conf.json",
    "canary": "pnpm config:build && tsx scripts/drift-canary.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@cloudflare/workers-types": "^5.20261022.1",
    "@fontsource/b612": "^5.3.0",
    "@fontsource/b612-mono": "^5.3.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.2",
    "fast-check": "3.23.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
