// CORTEX-54 brain worker. Workers FREE plan only (ADR-001). See docs/FREE_TIER_BUDGET.md before adding bindings.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cortex",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  "durable_objects": {
    "bindings": [{ "name": "CORTEX", "class_name": "AgentCortexDO" }]
  },
  // Free plan supports SQLite-backed Durable Objects only.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AgentCortexDO"] }],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cortex-journal",
      // Created 2026-10-22 on the operator account (Workers Free).
      "database_id": "c041a668-974e-4d34-90f1-d02fefa70793",
      "migrations_dir": "migrations"
    }
  ],

  // Kill flag shared with sentinel (KV free tier; the brain only reads it, ~1,440 reads/day).
  "kv_namespaces": [{ "binding": "FLAGS", "id": "3891963cf8c445ce90481c4d422596b6" }],

  // Workers AI: 10,000 neurons/day free, hard fail beyond. Every call goes through FreeTierBudget.
  "ai": { "binding": "AI" },

  // Workflows (Phase 3): ResearchSprintWorkflow binding is added when the class exists.

  // No cron (ADR-021): the operator account's 5 free cron slots are used by another worker. The Durable Object
  // arms its own alarm on start, and every /health call (sentinel tick) re-arms it. If a slot frees up,
  // ["*/5 * * * *"] here adds a belt-and-braces self-heal.
  "triggers": { "crons": [] },

  "vars": {
    "CORTEX_ENV": "production",
    "CORTEX_DO_NAME": "CORTEX-54-PRIMARY",
    // Discord channel ids (not secret): command_center, briefs, court, executions, alarms
    "DISCORD_CHANNELS": "{\"command_center\":\"1562933931324477455\",\"briefs\":\"1562933933849706556\",\"court\":\"1562933936299184240\",\"executions\":\"1562933938895323270\",\"world_intel\":\"1562933941147664424\",\"governor\":\"1562933943559389275\",\"alarms\":\"1562933946407321770\",\"terminal\":\"1562933948521123940\"}"
  }
}
