{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["web:dev", "--port", "5174", "--strictPort"],
      "port": 5174
    },
    {
      "name": "web-local",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["web:dev", "--port", "5175", "--strictPort"],
      "env": {
        "CORTEX_API": "http://127.0.0.1:8755"
      },
      "port": 5175
    },
    {
      "name": "landing",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["landing:preview"],
      "port": 5176
    },
    {
      "name": "app-demo",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["cortex", "demo", "--port", "8755"],
      "port": 8755
    },
    {
      "name": "hub-local",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["wrangler", "dev", "-c", "hub/wrangler.jsonc", "--local", "--port", "8791"],
      "port": 8791
    },
    {
      "name": "landing-local-hub",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["landing:preview"],
      "env": {
        "HUB_PROXY": "http://127.0.0.1:8791",
        "PREVIEW_PORT": "5177"
      },
      "port": 5177
    }
  ]
}
