# Copy to .dev.vars for `wrangler dev`. Never commit real values.
# Use PAPER keys locally. LIVE keys exist only as remote secrets (CLAUDE.md §10).
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET=
ALPACA_LIVE_KEY_ID=
ALPACA_LIVE_SECRET=
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
OPERATOR_DISCORD_ID=
# Channel IDs (also settable in wrangler.jsonc vars): {"command_center":"…","briefs":"…","court":"…","executions":"…","alarms":"…"}
DISCORD_CHANNELS={}
INGEST_HMAC_SECRET=
GEMINI_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
# LAB brain (ADR-045): a second paper account
ALPACA_LAB_KEY_ID=
ALPACA_LAB_SECRET=
# Brain-dispatched GitHub workflows (ADR-032) and the web terminal (ADR-034)
GH_DISPATCH_TOKEN=
WEB_SESSION_SECRET=
# Research job keys (GitHub Actions secrets; locally for dry runs)
FMP_API_KEY=
FRED_API_KEY=
# ADR-062 monitoring (optional): ntfy push topic (16–64 url-safe chars), optional self-hosted ntfy base, widget token
NTFY_TOPIC=
NTFY_URL=
PILL_TOKEN=
# ADR-063 BYOK court models (optional; paid keys are the user's choice)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=
RUNNER_MODE=
# ADR-068 community hub (optional): cortex hub keygen prints a key
HUB_URL=
HUB_AGENT_KEY=
HUB_AGENT_NAME=
HUB_PUBLISH=
HUB_FOLLOW=
