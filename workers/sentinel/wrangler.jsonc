// SENTINEL — independent watchdog + kill-switch (docs/ARCHITECTURE.md §12, ADR-012).
// Separate deploy, separate Discord app, its own copies of secrets. Shares no runtime code with `cortex`.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cortex-sentinel",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Per-minute watchdog (ADR-021, revised). GitHub Actions also calls POST /tick every 30 min as an independent backup.
  "triggers": { "crons": ["* * * * *"] },
  // Same KV namespace as cortex. Sentinel writes `killed`; the brain only reads it.
  // Run `pnpm wrangler kv namespace create FLAGS` and paste the id here and in ../../wrangler.jsonc.
  "kv_namespaces": [{ "binding": "FLAGS", "id": "3891963cf8c445ce90481c4d422596b6" }],
  "vars": {
    // Set to your deployed cortex URL, e.g. https://cortex.<subdomain>.workers.dev/health
    "CORTEX_HEALTH_URL": "https://cortex.samplayz2ks.workers.dev/health",
    // Brain pulses every 60–300 s; alert when the last pulse is older than this.
    "STALE_ALERT_MINUTES": "8",
    // Constitution max_daily_loss_pct. The brain's own RED (5%) normally trips first.
    "MAX_DAILY_LOSS_PCT": "0.06",
    "FLATTEN_ON_BRAIN_DEATH_MINUTES": "60"
  }
}
